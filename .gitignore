# =============================================================================
# CGPA Monitor — root .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache

# ── Database (contains student PII — never commit) ────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Scrape logs & runtime output ──────────────────────────────────────────────
scrape_log.txt
scrape_stderr.txt
scrape_stdout.txt
*.log
api_server.log

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.secret

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Next.js (web/ has its own .gitignore; these are belt-and-suspenders) ──────
web/.next/
web/out/
web/node_modules/
web/*.tsbuildinfo
web/.vercel/

# ── Generated static data (large; re-generated by export_static.py) ───────────
# Uncomment the lines below if you prefer NOT to commit the pre-built JSON.
# web/public/data/leaderboard.json
# web/public/data/students/
